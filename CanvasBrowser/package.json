{
  "name": "canvas-browser",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CanvasBrowser — a futuristic, honest browser simulator prototype (Vite + TypeScript, no UI framework).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:test": "tsc --noEmit && vite build --mode test",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "demo": "npm run build:demo && node server.mjs",
    "preview": "vite preview --port 4174 --strictPort",
    "preview:test": "vite preview --outDir dist-test --port 4175 --strictPort",
    "test": "playwright test",
    "test:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
