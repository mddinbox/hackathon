<Application x:Class="FloatingStockTicker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FloatingStockTicker.Controls"
             xmlns:models="clr-namespace:FloatingStockTicker.Models"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <FontFamily x:Key="AppFont">Segoe UI</FontFamily>

        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#2F353D" />
        <SolidColorBrush x:Key="WindowBorderBrush" Color="#5F6C7B" />
        <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#3A424C" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#3E4850" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#5F6D7C" />
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#353E46" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#6F7F8F" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F3F6FA" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#D0D8E1" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#96A3B2" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#7C8998" />
        <SolidColorBrush x:Key="ControlHoverBrush" Color="#4C5966" />
        <SolidColorBrush x:Key="ControlPressedBrush" Color="#5A6A7A" />
        <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#4A5663" />
        <SolidColorBrush x:Key="AccentBrush" Color="#5A8DEE" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#719FF4" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#4779D4" />
        <SolidColorBrush x:Key="HeaderActionBorderBrush" Color="#7D8998" />
        <LinearGradientBrush x:Key="HeaderActionBackgroundBrush"
                             StartPoint="0,0"
                             EndPoint="0,1">
            <GradientStop Offset="0" Color="#596675" />
            <GradientStop Offset="0.52" Color="#4A5664" />
            <GradientStop Offset="1" Color="#3D4753" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeaderActionHoverBrush"
                             StartPoint="0,0"
                             EndPoint="0,1">
            <GradientStop Offset="0" Color="#6E83A0" />
            <GradientStop Offset="0.52" Color="#5B718E" />
            <GradientStop Offset="1" Color="#485C76" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeaderActionPressedBrush"
                             StartPoint="0,0"
                             EndPoint="0,1">
            <GradientStop Offset="0" Color="#38424E" />
            <GradientStop Offset="0.5" Color="#424E5B" />
            <GradientStop Offset="1" Color="#526071" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PositiveBrush" Color="#50D394" />
        <SolidColorBrush x:Key="NegativeBrush" Color="#F27B83" />
        <SolidColorBrush x:Key="FlatBrush" Color="#B8C3CE" />
        <SolidColorBrush x:Key="WarningBrush" Color="#F2BF68" />
        <SolidColorBrush x:Key="SparklineReferenceBrush" Color="#D6DEE6" />
        <SolidColorBrush x:Key="SparklineSessionDividerBrush"
                         Color="#D6DEE6"
                         Opacity="0.28" />
        <SolidColorBrush x:Key="SessionIconBrush" Color="#BFD0E8" />
        <SolidColorBrush x:Key="OverviewDowBrush" Color="#3B82F6" />
        <SolidColorBrush x:Key="OverviewSpBrush" Color="#FBBF24" />
        <SolidColorBrush x:Key="OverviewNasdaqBrush" Color="#F472B6" />
        <SolidColorBrush x:Key="OverviewReferenceBrush"
                         Color="#7F8B96"
                         Opacity="0.72" />
        <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#2A3843" Opacity="0.42" />
        <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#7C8D9D" />
        <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#A0B1C2" />
        <SolidColorBrush x:Key="ScrollBarThumbPressedBrush" Color="#CAD9E5" />

        <Style x:Key="ScrollBarRepeatButtonStyle"
               TargetType="{x:Type RepeatButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>

        <Style x:Key="ScrollBarThumbStyle"
               TargetType="{x:Type Thumb}">
            <Setter Property="Background" Value="{StaticResource ScrollBarThumbBrush}" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                                Margin="1,1"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="{StaticResource ScrollBarThumbHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="{StaticResource ScrollBarThumbPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinVerticalScrollBarStyle"
               TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="4" />
            <Setter Property="Background" Value="{StaticResource ScrollBarTrackBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="{TemplateBinding Width}"
                              Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   Focusable="False"
                                   IsDirectionReversed="True"
                                   Orientation="Vertical">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Style="{StaticResource ScrollBarRepeatButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb"
                                           Style="{StaticResource ScrollBarThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Style="{StaticResource ScrollBarRepeatButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ControlPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactIconButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style x:Key="HeaderActionButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource HeaderActionBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HeaderActionBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid Width="{TemplateBinding Width}"
                              Height="{TemplateBinding Height}">
                            <Border x:Name="ButtonBorder"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="16">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4"
                                                      Direction="270"
                                                      Opacity="0.30"
                                                      ShadowDepth="1"
                                                      Color="#111820" />
                                </Border.Effect>
                            </Border>
                            <Border x:Name="ButtonHighlight"
                                    Margin="1.5"
                                    BorderBrush="#38FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="14.5"
                                    IsHitTestVisible="False" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource HeaderActionHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource HeaderActionPressedBrush}" />
                                <Setter TargetName="ButtonHighlight"
                                        Property="Opacity"
                                        Value="0.18" />
                                <Setter TargetName="ButtonBorder"
                                        Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="2"
                                                          Direction="270"
                                                          Opacity="0.3"
                                                          ShadowDepth="1"
                                                          Color="#111820" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource PrimaryTextBrush}" />
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderThickness"
                                        Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TickerCardBorderStyle"
               TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="MarketOverviewBorderStyle"
               TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="MarketOverviewTitleStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MarketOverviewLabelStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MarketOverviewPriceStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="Arial Narrow" />
            <Setter Property="FontSize" Value="{x:Static models:TickerCardTypography.NumericFontSize}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LineHeight" Value="{x:Static models:TickerCardTypography.NumericLineHeight}" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        </Style>

        <Style x:Key="MarketOverviewChangeStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Arial Narrow" />
            <Setter Property="FontSize" Value="{x:Static models:TickerCardTypography.NumericFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="{x:Static models:TickerCardTypography.NumericLineHeight}" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="MarketOverviewChartStyle"
               TargetType="{x:Type controls:CompositeSparklineControl}">
            <Setter Property="Margin" Value="2,7,2,0" />
            <Setter Property="Height" Value="70" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>

        <GridLength x:Key="TickerCardSessionIconColumnWidth">24</GridLength>

        <Style x:Key="TickerCardQuoteStackStyle"
               TargetType="{x:Type Grid}">
            <Setter Property="Margin" Value="6,0,2,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TickerCardSessionIconStyle"
               TargetType="{x:Type controls:SessionIconControl}">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="IconBrush" Value="{StaticResource SessionIconBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TickerCardQuotePriceTextStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="Arial Narrow" />
            <Setter Property="FontSize" Value="{x:Static models:TickerCardTypography.NumericFontSize}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LineHeight" Value="{x:Static models:TickerCardTypography.NumericLineHeight}" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TickerCardPriceTextStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource TickerCardQuotePriceTextStyle}" />

        <Style x:Key="TickerCardQuoteChangeTextStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Arial Narrow" />
            <Setter Property="FontSize" Value="{x:Static models:TickerCardTypography.NumericFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="{x:Static models:TickerCardTypography.NumericLineHeight}" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TickerCardChangeTextStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource TickerCardQuoteChangeTextStyle}">
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <Style x:Key="TickerCardExtendedPriceTextStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource TickerCardQuotePriceTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>

        <Style x:Key="TickerCardExtendedChangeTextStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource TickerCardQuoteChangeTextStyle}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource FlatBrush}" />
        </Style>

        <Style x:Key="TickerCardSparklineStyle"
               TargetType="{x:Type controls:SparklineControl}">
            <Setter Property="Margin" Value="2,0,24,0" />
            <Setter Property="Height" Value="86" />
            <Setter Property="StrokeThickness"
                    Value="{x:Static models:SparklineMetrics.SeriesStrokeThickness}" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="TickerCardRemoveButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style x:Key="TickerCardErrorTextStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Foreground" Value="{StaticResource NegativeBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="{x:Static models:TickerCardTypography.TileFontSize}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource SecondaryButtonBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ControlPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryTextBrush}" />
        </Style>

        <Style x:Key="CompactTextBoxStyle"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource TextBoxStyle}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="16" />
        </Style>
    </Application.Resources>
</Application>
