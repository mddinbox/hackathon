<Window x:Class="FloatingStockTicker.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ticker settings"
        Icon="/Assets/FloatingStockTicker.ico"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        ShowInTaskbar="False">
    <Border Padding="24"
            Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="{StaticResource WindowBorderBrush}"
            BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Ticker settings"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="16"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,5,0,22"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="16"
                       Text="Yahoo Finance chart quotes require no API key." />

            <CheckBox x:Name="AlwaysOnTopBox"
                      Margin="0,0,0,18"
                      Foreground="{StaticResource SecondaryTextBrush}"
                      FontFamily="{StaticResource AppFont}"
                      FontSize="16"
                      Content="Keep the ticker always on top" />

            <CheckBox x:Name="EnableGlobalShortcutBox"
                      Margin="0,0,0,18"
                      Foreground="{StaticResource SecondaryTextBrush}"
                      FontFamily="{StaticResource AppFont}"
                      FontSize="16"
                      Content="Enable global shortcut (Ctrl+Alt+Shift+F12)" />

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="16"
                           Text="Polling interval (seconds)" />
                <TextBox x:Name="PollingIntervalBox"
                         Grid.Column="1"
                         Width="88"
                         HorizontalContentAlignment="Right"
                         FontFamily="{StaticResource AppFont}"
                         FontSize="16"
                         Style="{StaticResource CompactTextBoxStyle}" />
            </Grid>
            <TextBlock Margin="0,0,0,18"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="16"
                       Text="Minimum 10 seconds; maximum 3600 seconds." />

            <CheckBox x:Name="PauseDuringQuietHoursBox"
                      Margin="0,0,0,18"
                      Foreground="{StaticResource SecondaryTextBrush}"
                      FontFamily="{StaticResource AppFont}"
                      FontSize="16">
                <TextBlock Text="Pause weekends and weekdays from 6 PM to 6 AM (local time)"
                           TextWrapping="Wrap" />
            </CheckBox>

            <TextBlock x:Name="ValidationText"
                       Margin="0,0,0,14"
                       Foreground="{StaticResource NegativeBrush}"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="16"
                       TextWrapping="Wrap" />

            <Grid>
                <TextBlock x:Name="VersionText"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="16" />
                <StackPanel HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button Margin="0,0,9,0"
                            Click="CancelButton_OnClick"
                            Content="Cancel"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Click="SaveButton_OnClick"
                            Content="Save"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
